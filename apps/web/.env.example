# Optional MapLibre style URL. Defaults to the keyless OpenFreeMap dark style.
# Point this at a self-hosted style for offline or intranet-only deployments.
VITE_MAP_STYLE_URL=

# Optional default station location. The API does not store coordinates.
# URL parameters and the in-page location dialog override these values.
VITE_STATION_LAT=
VITE_STATION_LON=
